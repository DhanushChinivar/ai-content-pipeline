# Credentials this pipeline needs.
#
# These live in n8n Cloud's credential store, NOT in a .env file — n8n runs the
# workflow, not your machine. This file documents what's required so the pipeline
# can be rebuilt from scratch.
#
# Never commit real values.

# --- Research -----------------------------------------------------------------
# Firecrawl: search + scrape the top-ranking articles.
# n8n credential type: Header Auth → Authorization: Bearer <key>
FIRECRAWL_API_KEY=fc-...

# --- Analysis + writing -------------------------------------------------------
# Anthropic: gap analysis (call 1) and article writing (call 2).
# n8n credential type: Header Auth → x-api-key: <key>
# Also send: anthropic-version: 2023-06-01
ANTHROPIC_API_KEY=sk-ant-...

# --- Draft destination --------------------------------------------------------
# Notion internal integration (notion.so/my-integrations).
# n8n credential type: Header Auth → Authorization: Bearer <token>
# Also send: Notion-Version: 2022-06-28   (required header, not optional)
#
# The integration must be explicitly connected to the target database:
# open the database → ⋯ → Connections → Connect to → your integration.
# Skipping that returns object_not_found even with a valid token.
NOTION_TOKEN=ntn_...

# 32-char id from the database URL: notion.so/workspace/<THIS>?v=...
NOTION_DATABASE_ID=

# --- Trigger ------------------------------------------------------------------
# Google Sheets uses OAuth via n8n, so there's no key here. Recorded for reference:
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Topics
